---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const selectedCategories = Astro.url.searchParams.getAll('category').map(Number).filter(Number.isInteger);
const selectedPublisher = Astro.url.searchParams.get('publisher');
const selectedPublisherId = selectedPublisher ? Number(selectedPublisher) : null;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-lg" aria-labelledby="game-filters-heading">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 id="game-filters-heading" class="text-2xl font-medium text-slate-100">Filter games</h2>
        {(selectedCategories.length > 0 || selectedPublisherId !== null) && (
          <a href="/" class="text-sm font-medium text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900" data-testid="clear-filters">
            Clear filters
          </a>
        )}
      </div>

      <form method="GET" action="/" class="space-y-5" data-testid="game-filters" aria-label="Filter game catalog">
        <fieldset class="space-y-3">
          <legend class="text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => {
              const isChecked = selectedCategories.includes(category.id);
              return (
                <label
                  for={`category-${category.id}`}
                  class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500"
                >
                  <input
                    id={`category-${category.id}`}
                    type="checkbox"
                    name="category"
                    value={String(category.id)}
                    checked={isChecked}
                    data-testid={`category-filter-${category.id}`}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              );
            })}
          </div>
        </fieldset>

        <div class="flex flex-col gap-2 sm:max-w-xs">
          <label for="publisher-filter" class="text-sm font-medium uppercase tracking-wide text-slate-300">
            Publisher
          </label>
          <select
            id="publisher-filter"
            name="publisher"
            data-testid="publisher-filter"
            class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Filter games by publisher"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)} selected={selectedPublisherId === publisher.id}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
        </div>
      </form>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div
            data-testid="games-empty-state"
            class="hidden rounded-xl border border-slate-700 bg-slate-800/50 px-6 py-12 text-center text-slate-300"
            hidden
          >
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script is:inline>
    const filterForm = document.querySelector('[data-testid="game-filters"]');
    const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const categoryInputs = Array.from(document.querySelectorAll('input[name="category"]'));
    const publisherSelect = document.querySelector('[data-testid="publisher-filter"]');
    const emptyState = document.querySelector('[data-testid="games-empty-state"]');

    function updateVisibleCards() {
      const selectedCategories = categoryInputs.filter((input) => input.checked).map((input) => input.value);
      const selectedPublisher = publisherSelect && publisherSelect.value ? publisherSelect.value : '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryValue = card.dataset.gameCategory || '';
        const publisherValue = card.dataset.gamePublisher || '';
        const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(categoryValue);
        const matchesPublisher = selectedPublisher === '' || selectedPublisher === publisherValue;
        const shouldShow = matchesCategory && matchesPublisher;

        card.hidden = !shouldShow;

        if (shouldShow) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }
    }

    function syncQueryString() {
      const url = new URL(window.location.href);
      url.search = '';

      categoryInputs
        .filter((input) => input.checked)
        .forEach((input) => url.searchParams.append('category', input.value));

      if (publisherSelect && publisherSelect.value) {
        url.searchParams.set('publisher', publisherSelect.value);
      }

      window.history.replaceState({}, '', url.toString());
    }

    function handleFilterChange() {
      updateVisibleCards();
      syncQueryString();
    }

    if (filterForm) {
      filterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        handleFilterChange();
      });
    }

    categoryInputs.forEach((input) => {
      input.addEventListener('change', handleFilterChange);
    });

    if (publisherSelect) {
      publisherSelect.addEventListener('change', handleFilterChange);
    }

    updateVisibleCards();
  </script>
</Layout>
